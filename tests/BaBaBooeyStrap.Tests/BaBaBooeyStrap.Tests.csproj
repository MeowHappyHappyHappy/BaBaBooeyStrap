<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Conditional Project References for Standalone and Integrated Operation -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\BaBaBooeyStrap.Core\BaBaBooeyStrap.Core.csproj" 
                      Condition="Exists('..\..\src\BaBaBooeyStrap.Core\BaBaBooeyStrap.Core.csproj')" />
    <ProjectReference Include="..\..\src\BaBaBooeyStrap.MultiInstance\BaBaBooeyStrap.MultiInstance.csproj" 
                      Condition="Exists('..\..\src\BaBaBooeyStrap.MultiInstance\BaBaBooeyStrap.MultiInstance.csproj')" />
    <ProjectReference Include="..\..\src\BaBaBooeyStrap.Bootstrapper\BaBaBooeyStrap.Bootstrapper.csproj" 
                      Condition="Exists('..\..\src\BaBaBooeyStrap.Bootstrapper\BaBaBooeyStrap.Bootstrapper.csproj')" />
    <ProjectReference Include="..\..\src\BaBaBooeyStrap.Integrations\BaBaBooeyStrap.Integrations.csproj" 
                      Condition="Exists('..\..\src\BaBaBooeyStrap.Integrations\BaBaBooeyStrap.Integrations.csproj')" />
    <ProjectReference Include="..\..\src\BaBaBooeyStrap.App\BaBaBooeyStrap.App.csproj" 
                      Condition="Exists('..\..\src\BaBaBooeyStrap.App\BaBaBooeyStrap.App.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
