<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:BaBaBooeyStrap.App.Converters"
                    xmlns:services="clr-namespace:BaBaBooeyStrap.App.Services">
    <conv:LocalizedEnumMultiConverter x:Key="LocalizedEnumMultiConverter" />
    <conv:LocalizedFormatMultiConverter x:Key="LocalizedFormatMultiConverter" />
    <conv:HexStringToBrushConverter x:Key="HexStringToBrushConverter" />

    <DataTemplate x:Key="LocalizedEnumItemTemplate">
        <TextBlock>
            <TextBlock.Text>
                <MultiBinding Converter="{x:Static conv:LocalizedEnumMultiConverter.Instance}">
                    <Binding />
                    <Binding Source="{x:Static services:LocalizationService.Instance}" Path="CurrentLanguageTag" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>

    <Style x:Key="AppPageStyle" TargetType="{x:Type Page}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
    </Style>
</ResourceDictionary>
