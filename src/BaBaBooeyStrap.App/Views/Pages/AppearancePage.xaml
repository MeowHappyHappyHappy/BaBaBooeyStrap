<Page x:Class="BaBaBooeyStrap.App.Views.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:BaBaBooeyStrap.App.Converters"
      xmlns:services="clr-namespace:BaBaBooeyStrap.App.Services"
      Style="{DynamicResource AppPageStyle}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{DynamicResource Str_Appearance_PageTitle}">
    <Page.Resources>
        <conv:HexStringToBrushConverter x:Key="HexToBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel>
            <TextBlock Text="{DynamicResource Str_Appearance_Header}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- App UI Theme & Language -->
            <Border CornerRadius="8" Padding="16" Margin="0,0,0,14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Appearance_WindowThemeHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_AppTheme}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding WindowIntegrations.AvailableThemes}" SelectedItem="{Binding WindowIntegrations.CurrentTheme}" ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_Language}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding WindowIntegrations.AvailableLanguages}" SelectedItem="{Binding WindowIntegrations.CurrentLanguage}" ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"/>
                    </Grid>
                    <DockPanel Margin="0,6,0,8">
                        <TextBlock Text="{DynamicResource Str_Appearance_UseAcrylic}" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch IsChecked="{Binding WindowIntegrations.UseAcrylicBackground}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Grid IsEnabled="{Binding WindowIntegrations.UseAcrylicBackground}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_AcrylicOpacity}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding WindowIntegrations.AcrylicBackgroundOpacity}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding WindowIntegrations.AcrylicBackgroundOpacity}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bootstrapper Dialog Style -->
            <Border CornerRadius="8" Padding="16" Margin="0,0,0,14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Appearance_DialogThemeHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_BootstrapperStyle}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding WindowIntegrations.AvailableBootstrapperStyles}" SelectedItem="{Binding WindowIntegrations.SelectedBootstrapperStyle}" ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_BootstrapperTitle}" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Column="1" Text="{Binding WindowIntegrations.BootstrapperTitle, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_BootstrapperIcon}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding WindowIntegrations.AvailableBootstrapperIcons}" SelectedItem="{Binding WindowIntegrations.SelectedBootstrapperIcon}" ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"/>
                    </Grid>
                    <Grid Margin="0,0,0,4" IsEnabled="{Binding WindowIntegrations.IsCustomBootstrapperIconSelected}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_CustomIcon}" VerticalAlignment="Center"/>
                        <Image Grid.Column="1"
                               Width="24"
                               Height="24"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Source="{Binding WindowIntegrations.CustomIconPreviewImage}"
                               Visibility="{Binding WindowIntegrations.HasCustomIconPreview, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ui:TextBox Grid.Column="2" Text="{Binding WindowIntegrations.BootstrapperIconCustomLocation, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <ui:Button Grid.Column="3" Content="{DynamicResource Str_Common_Browse}" Click="BrowseBootstrapperIcon_Click"/>
                    </Grid>
                    <TextBlock Text="{Binding WindowIntegrations.CustomIconWarningText}"
                               Visibility="{Binding WindowIntegrations.HasCustomIconWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="#FFF59E0B"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="220,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_CustomXmlTheme}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding WindowIntegrations.AvailableCustomThemes}" SelectedItem="{Binding WindowIntegrations.SelectedCustomTheme}" Margin="0,0,8,0"/>
                        <ui:Button Grid.Column="2" Content="{DynamicResource Str_Appearance_OpenThemesFolder}" Click="OpenThemesFolder_Click"/>
                    </Grid>

                    <!-- Preview Swatch -->
                    <Border CornerRadius="6" Padding="12" Margin="0,6,0,0"
                            Background="{Binding WindowIntegrations.PreviewTheme.Background, Converter={StaticResource HexToBrush}}">
                        <DockPanel>
                            <TextBlock Foreground="{Binding WindowIntegrations.PreviewTheme.Foreground, Converter={StaticResource HexToBrush}}"
                                       FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static conv:LocalizedFormatMultiConverter.Instance}" ConverterParameter="Str_Appearance_XmlPreviewFormat">
                                        <Binding Source="{x:Static services:LocalizationService.Instance}" Path="CurrentLanguageTag"/>
                                        <Binding Path="WindowIntegrations.PreviewTheme.Name"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <ui:Button Content="{DynamicResource Str_Appearance_PreviewDialog}" Click="PreviewDialog_Click" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Roblox Window Identity -->
            <Border CornerRadius="8" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Appearance_RobloxIdentityHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_RobloxTitle}" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Column="1" Text="{Binding WindowIntegrations.RobloxTitle, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_RobloxIcon}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding WindowIntegrations.AvailableRobloxIcons}" SelectedItem="{Binding WindowIntegrations.SelectedRobloxIcon}" ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"/>
                    </Grid>
                    <Grid Margin="0,0,0,4" IsEnabled="{Binding WindowIntegrations.IsCustomRobloxIconSelected}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_RobloxCustomIcon}" VerticalAlignment="Center"/>
                        <Image Grid.Column="1"
                               Width="24"
                               Height="24"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Source="{Binding WindowIntegrations.CustomRobloxIconPreviewImage}"
                               Visibility="{Binding WindowIntegrations.HasCustomRobloxIconPreview, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ui:TextBox Grid.Column="2" Text="{Binding WindowIntegrations.RobloxIconCustomLocation, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <ui:Button Grid.Column="3" Content="{DynamicResource Str_Common_Browse}" Click="BrowseRobloxIcon_Click"/>
                    </Grid>
                    <TextBlock Text="{Binding WindowIntegrations.CustomRobloxIconWarningText}"
                               Visibility="{Binding WindowIntegrations.HasCustomRobloxIconWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="#FFF59E0B"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="220,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
