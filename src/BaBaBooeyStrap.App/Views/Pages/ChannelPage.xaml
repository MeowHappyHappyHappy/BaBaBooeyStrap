<Page x:Class="BaBaBooeyStrap.App.Views.Pages.ChannelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:BaBaBooeyStrap.App.Converters"
      xmlns:services="clr-namespace:BaBaBooeyStrap.App.Services"
      Style="{DynamicResource AppPageStyle}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{DynamicResource Str_Channel_PageTitle}">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel>
            <TextBlock Text="{DynamicResource Str_Channel_Header}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Channel_EnvHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <DockPanel Margin="0,4">
                        <TextBlock Text="{DynamicResource Str_Channel_ForceRobloxLanguage}" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch IsChecked="{Binding LaunchSettings.ForceRobloxLanguage}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,10">
                        <TextBlock Text="{DynamicResource Str_Channel_ForceReinstall}" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch IsChecked="{Binding LaunchSettings.ForceReinstall}" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Expander Header="{DynamicResource Str_Channel_AdvancedHeader}" IsExpanded="False">
                        <StackPanel Margin="0,10,0,0">
                            <Border CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,12"
                                    Background="#22F59E0B"
                                    BorderBrush="#FFF59E0B"
                                    BorderThickness="1">
                                <TextBlock Text="{DynamicResource Str_Channel_AdvancedWarning}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="#FFF59E0B"/>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_Channel_ChannelName}" VerticalAlignment="Center"/>
                                <ui:TextBox Grid.Column="1" Text="{Binding LaunchSettings.Channel, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_Channel_ChangeMode}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding LaunchSettings.AvailableChannelChangeModes}" SelectedItem="{Binding LaunchSettings.SelectedChannelChangeMode}" ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_Channel_DistributorType}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding LaunchSettings.AvailableDistributorTypes}" SelectedItem="{Binding LaunchSettings.SelectedDistributorType}" ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_Channel_WebEnvironment}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding LaunchSettings.AvailableWebEnvironments}" SelectedItem="{Binding LaunchSettings.SelectedWebEnvironment}" ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_Channel_RobloxDomain}" VerticalAlignment="Center"/>
                                <ui:TextBox Grid.Column="1" Text="{Binding LaunchSettings.RobloxDomain, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_Channel_LocaleOverride}" VerticalAlignment="Center"/>
                                <ui:TextBox Grid.Column="1" Text="{Binding LaunchSettings.Locale, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <ui:Button Content="{DynamicResource Str_Channel_ResetDefaults}"
                                       Click="ResetChannelDefaults_Click"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Channel_CdnHeader}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Opacity="0.75">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static conv:LocalizedFormatMultiConverter.Instance}" ConverterParameter="Str_Channel_InstalledPlayerFormat">
                                        <Binding Source="{x:Static services:LocalizationService.Instance}" Path="CurrentLanguageTag"/>
                                        <Binding Path="LaunchSettings.InstalledPlayerVersion"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:ProgressRing Width="18"
                                             Height="18"
                                             IsIndeterminate="True"
                                             Visibility="{Binding LaunchSettings.IsTestingCdn, Converter={StaticResource BoolToVisibilityConverter}}"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>
                            <ui:Button Content="{DynamicResource Str_Channel_TestFastestCdn}"
                                       Appearance="Primary"
                                       IsEnabled="{Binding LaunchSettings.IsNotTestingCdn}"
                                       Click="TestCdn_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding LaunchSettings.GlobalMirrors}" Margin="0,4,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding LaunchSettings.CdnTestResult}" FontWeight="SemiBold" Opacity="0.85"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
