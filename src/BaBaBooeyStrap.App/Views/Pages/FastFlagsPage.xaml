<Page x:Class="BaBaBooeyStrap.App.Views.Pages.FastFlagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:BaBaBooeyStrap.App.Converters"
      Style="{DynamicResource AppPageStyle}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{DynamicResource Str_FastFlags_PageTitle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Str_FastFlags_Header}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <ui:Button Grid.Column="1" Content="{DynamicResource Str_FastFlags_OpenEditor}" Appearance="Primary" Click="OpenEditor_Click" HorizontalAlignment="Right"/>
            </Grid>

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_FastFlags_EnableManager}"/>
                            <TextBlock Text="{DynamicResource Str_FastFlags_EnableManagerDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding FastFlags.UseFastFlagManager}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_FastFlags_DisableAppPatch}"/>
                            <TextBlock Text="{DynamicResource Str_FastFlags_DisableAppPatchDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding FastFlags.UseDisableAppPatch}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="16" IsEnabled="{Binding FastFlags.UseFastFlagManager}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_FastFlags_EnginePresetsHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding FastFlags.WriteRenderingMode, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str_FastFlags_RenderingApi}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="RenderingCombo" Grid.Column="2" SelectedItem="{Binding FastFlags.SelectedRenderingMode}" IsEnabled="{Binding FastFlags.WriteRenderingMode}" ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding FastFlags.WriteMSAAMode, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str_FastFlags_Msaa}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MsaaCombo" Grid.Column="2" SelectedItem="{Binding FastFlags.SelectedMSAAMode}" IsEnabled="{Binding FastFlags.WriteMSAAMode}" ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding FastFlags.WriteFrmQualityOverride, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_FastFlags_FrmQuality}"/>
                            <TextBlock Text="{DynamicResource Str_FastFlags_FrmQualityDesc}" FontSize="11.5" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:NumberBox Grid.Column="2"
                                      Value="{Binding FastFlags.FrmQualityOverride, Mode=TwoWay, Converter={x:Static conv:NullableDoubleToIntConverter.Instance}}"
                                      ClearButtonEnabled="False"
                                      conv:NumberBoxGuard.RestoreOnEmpty="True"
                                      IsEnabled="{Binding FastFlags.WriteFrmQualityOverride}"
                                      Minimum="1"
                                      Maximum="21"
                                      SpinButtonPlacementMode="Inline"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding FastFlags.WriteMeshLodLevel, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_FastFlags_MeshLod}"/>
                            <TextBlock Text="{DynamicResource Str_FastFlags_MeshLodDesc}" FontSize="11.5" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:NumberBox Grid.Column="2"
                                      Value="{Binding FastFlags.MeshLodLevel, Mode=TwoWay, Converter={x:Static conv:NullableDoubleToIntConverter.Instance}}"
                                      ClearButtonEnabled="False"
                                      conv:NumberBoxGuard.RestoreOnEmpty="True"
                                      IsEnabled="{Binding FastFlags.WriteMeshLodLevel}"
                                      Minimum="0"
                                      Maximum="3"
                                      SpinButtonPlacementMode="Inline"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding FastFlags.WriteDisableDpiScaling, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_FastFlags_DisableDpiScaling}"/>
                            <TextBlock Text="{DynamicResource Str_FastFlags_DisableDpiScalingDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding FastFlags.DisableDpiScaling}" IsEnabled="{Binding FastFlags.WriteDisableDpiScaling}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding FastFlags.WriteManualFullscreen, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_FastFlags_ManualFullscreen}"/>
                            <TextBlock Text="{DynamicResource Str_FastFlags_ManualFullscreenDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding FastFlags.ManualFullscreen}" IsEnabled="{Binding FastFlags.WriteManualFullscreen}" VerticalAlignment="Center"/>
                    </Grid>

                    <ui:Button Content="{DynamicResource Str_FastFlags_ApplyPresets}" Appearance="Secondary" Click="ApplyPresets_Click" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
