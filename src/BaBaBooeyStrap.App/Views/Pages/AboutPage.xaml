<Page x:Class="BaBaBooeyStrap.App.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:BaBaBooeyStrap.App.Converters"
      xmlns:services="clr-namespace:BaBaBooeyStrap.App.Services"
      Style="{DynamicResource AppPageStyle}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{DynamicResource Str_About_PageTitle}">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel>
            <TextBlock Text="{DynamicResource Str_About_Header}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <Border CornerRadius="8" Padding="20" Margin="0,0,0,14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="BaBaBooeyStrap" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Opacity="0.8" Margin="0,2,0,8">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static conv:LocalizedFormatMultiConverter.Instance}" ConverterParameter="Str_About_VersionFormat">
                                <Binding Source="{x:Static services:LocalizationService.Instance}" Path="CurrentLanguageTag"/>
                                <Binding Path="LaunchSettings.AppVersion"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding LaunchSettings.RuntimeInfo}" Opacity="0.7" FontSize="12.5" Margin="0,0,0,14"/>

                    <TextBlock Text="{DynamicResource Str_About_Description}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="{DynamicResource Str_About_OpenLogs}" Appearance="Primary" Click="OpenLogs_Click" Margin="0,0,8,8"/>
                        <ui:Button Content="{DynamicResource Str_About_CheckUpdates}"
                                   IsEnabled="{Binding LaunchSettings.IsNotCheckingAppUpdate}"
                                   Click="CheckUpdates_Click"
                                   Margin="0,0,10,8"/>
                        <ui:ProgressRing Width="18"
                                         Height="18"
                                         IsIndeterminate="True"
                                         Visibility="{Binding LaunchSettings.IsCheckingAppUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                         Margin="0,0,8,8"
                                         VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LaunchSettings.AppUpdateStatusText}"
                                   Opacity="0.8"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Troubleshooting Card -->
            <Border CornerRadius="8" Padding="20" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_About_TroubleshootingHeader}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Str_About_TroubleshootingDesc}" FontSize="12.5" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="{DynamicResource Str_About_ResetFastFlags}" Click="ResetFastFlags_Click" Margin="0,0,8,8"/>
                        <ui:Button Content="{DynamicResource Str_About_ClearCacheNow}" Click="ClearCacheImmediate_Click" Margin="0,0,8,8"/>
                        <ui:Button Content="{DynamicResource Str_About_RepairProtocols}" Click="RepairProtocols_Click" Margin="0,0,8,8"/>
                        <ui:Button Content="{DynamicResource Str_About_ExportDiagnostics}" Appearance="Primary" Click="ExportDiagnostics_Click" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
