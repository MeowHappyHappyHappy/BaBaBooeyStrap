<Page x:Class="BaBaBooeyStrap.App.Views.Pages.BehaviourPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Style="{DynamicResource AppPageStyle}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{DynamicResource Str_Behaviour_PageTitle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel>
            <TextBlock Text="{DynamicResource Str_Behaviour_Header}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Behaviour_LauncherHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="{DynamicResource Str_Behaviour_CheckUpdates}" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch IsChecked="{Binding LaunchSettings.CheckForUpdates}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_Behaviour_CheckAppUpdates}"/>
                            <TextBlock Text="{DynamicResource Str_Behaviour_CheckAppUpdatesDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchSettings.CheckAppUpdates}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_Behaviour_RunOnStartup}"/>
                            <TextBlock Text="{DynamicResource Str_Behaviour_RunOnStartupDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchSettings.RunOnStartup}" VerticalAlignment="Center"/>
                    </Grid>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="{DynamicResource Str_Behaviour_BackgroundUpdates}" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch IsChecked="{Binding LaunchSettings.BackgroundUpdatesEnabled}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_Behaviour_ConfirmLaunches}"/>
                            <TextBlock Text="{DynamicResource Str_Behaviour_ConfirmLaunchesDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchSettings.ConfirmLaunches}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_Behaviour_MinimizeToTray}"/>
                            <TextBlock Text="{DynamicResource Str_Behaviour_MinimizeToTrayDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding WindowIntegrations.MinimizeToTray}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_Behaviour_WpfSoftwareRender}"/>
                            <TextBlock Text="{DynamicResource Str_Behaviour_WpfSoftwareRenderDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchSettings.WPFSoftwareRender}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,6,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_Behaviour_DeveloperMode}"/>
                            <TextBlock Text="{DynamicResource Str_Behaviour_DeveloperModeDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchSettings.DeveloperMode}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Behaviour_IntegrationsHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="{DynamicResource Str_Behaviour_ActivityTracking}" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch IsChecked="{Binding WindowIntegrations.EnableActivityTracking}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="{DynamicResource Str_Behaviour_DiscordRpc}" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch IsChecked="{Binding WindowIntegrations.UseDiscordRichPresence}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="{DynamicResource Str_Behaviour_HideRpcButtons}" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch IsChecked="{Binding WindowIntegrations.HideRPCButtons}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="{DynamicResource Str_Behaviour_ShowServerDetails}" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch IsChecked="{Binding WindowIntegrations.ShowServerDetails}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_Behaviour_WindowManipulation}"/>
                            <TextBlock Text="{DynamicResource Str_Behaviour_WindowManipulationDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding WindowIntegrations.EnableWindowManipulation}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_Behaviour_FakeBorderless}"/>
                            <TextBlock Text="{DynamicResource Str_Behaviour_FakeBorderlessDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding WindowIntegrations.FakeBorderlessFullscreen}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,6,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_Behaviour_BetterMatchmaking}"/>
                            <TextBlock Text="{DynamicResource Str_Behaviour_BetterMatchmakingDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding WindowIntegrations.EnableBetterMatchmaking}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="16" Margin="0,0,0,14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Str_Behaviour_CleanerHeader}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ui:Button Content="{DynamicResource Str_Behaviour_CleanNow}" Appearance="Primary" Click="CleanNow_Click" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Behaviour_RetentionPolicy}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding WindowIntegrations.AvailableCleanerOptions}" SelectedItem="{Binding WindowIntegrations.SelectedCleanerOption}" ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"/>
                    </Grid>
                    <WrapPanel>
                        <CheckBox Content="{DynamicResource Str_Behaviour_CleanRobloxCache}" IsChecked="{Binding WindowIntegrations.CleanRobloxCache}" Margin="0,0,16,6"/>
                        <CheckBox Content="{DynamicResource Str_Behaviour_CleanRobloxStudioCache}" IsChecked="{Binding WindowIntegrations.CleanRobloxStudioCache}" Margin="0,0,16,6"/>
                        <CheckBox Content="{DynamicResource Str_Behaviour_CleanRobloxLogs}" IsChecked="{Binding WindowIntegrations.CleanRobloxLogs}" Margin="0,0,16,6"/>
                        <CheckBox Content="{DynamicResource Str_Behaviour_CleanBaBaBooeyStrapLogs}" IsChecked="{Binding WindowIntegrations.CleanBaBaBooeyStrapLogs}" Margin="0,0,16,6"/>
                        <CheckBox Content="{DynamicResource Str_Behaviour_CleanCrashDumps}" IsChecked="{Binding WindowIntegrations.CleanRobloxCrashDumps}" Margin="0,0,16,6"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding WindowIntegrations.CleanerStatusText}" Opacity="0.75" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Custom Integrations -->
            <Border CornerRadius="8" Padding="16" Margin="0,0,0,14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Behaviour_CustomIntegrationsHeader}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Str_Behaviour_CustomIntegrationsDesc}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:Button Content="{DynamicResource Str_Behaviour_AddIntegration}" Appearance="Primary" Click="AddIntegration_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="{DynamicResource Str_Behaviour_CustomIntegrationsEmpty}"
                               FontSize="12.5"
                               Opacity="0.65"
                               Margin="0,2,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowIntegrations.CustomIntegrations.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding WindowIntegrations.CustomIntegrations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,6"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Location}" FontSize="11.5" Opacity="0.72" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Content="{DynamicResource Str_Common_Edit}" Click="EditIntegration_Click" Margin="0,0,6,0" Padding="10,4"/>
                                            <ui:Button Content="{DynamicResource Str_Common_Remove}" Appearance="Danger" Click="RemoveIntegration_Click" Padding="10,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Profile Backup & Restore -->
            <Border CornerRadius="8" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Behaviour_ProfileHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Str_Behaviour_ProfileDesc}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <ui:Button Content="{DynamicResource Str_Behaviour_ExportProfile}" Appearance="Primary" Click="ExportProfile_Click" Margin="0,0,8,0"/>
                        <ui:Button Content="{DynamicResource Str_Behaviour_ImportProfile}" Click="ImportProfile_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
