<Window x:Class="BaBaBooeyStrap.App.Views.Dialogs.QuickSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="500"
        SizeToContent="Height"
        MaxHeight="560"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Border Margin="12"
            CornerRadius="12"
            Background="#F21A1D24"
            BorderBrush="#3DFFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str_QuickSwitcher_Title}"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border CornerRadius="6"
                            Padding="7,2"
                            Margin="10,0,0,0"
                            Background="#24FFFFFF"
                            VerticalAlignment="Center">
                        <TextBlock Text="1-9 · ↑↓ · Enter · Esc"
                                   Foreground="#CCFFFFFF"
                                   FontSize="11"
                                   FontFamily="Consolas"/>
                    </Border>
                </StackPanel>
                <Button x:Name="TileButton"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Content="{DynamicResource Str_QuickSwitcher_TileAll}"
                        Padding="10,4"
                        FontSize="11.5"
                        Foreground="White"
                        Background="#28FFFFFF"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="TileAll_Click"/>
            </DockPanel>

            <!-- Search Box -->
            <ui:TextBox x:Name="SearchBox"
                        Grid.Row="1"
                        PlaceholderText="{DynamicResource Str_QuickSwitcher_SearchPlaceholder}"
                        Margin="0,0,0,10"
                        TextChanged="SearchBox_TextChanged"/>

            <!-- Running Instances List -->
            <ListBox x:Name="InstanceList"
                     Grid.Row="2"
                     MaxHeight="360"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="InstanceList_MouseDoubleClick"
                     PreviewMouseLeftButtonUp="InstanceList_PreviewMouseLeftButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemCard"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Background="#14FFFFFF"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            Cursor="Hand">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemCard" Property="Background" Value="#26FFFFFF"/>
                                            <Setter TargetName="ItemCard" Property="BorderBrush" Value="#55FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemCard" Property="Background" Value="#333B82F6"/>
                                            <Setter TargetName="ItemCard" Property="BorderBrush" Value="#FF60A5FA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Slot Badge -->
                            <Border Grid.Column="0"
                                    MinWidth="30"
                                    Height="30"
                                    CornerRadius="7"
                                    Margin="0,0,10,0"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding SlotBackground}">
                                <TextBlock Text="{Binding SlotText}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="12.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Account & Status -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PrimaryTitle}"
                                               Foreground="White"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Visibility="{Binding FocusedVisibility}"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            Margin="8,0,0,0"
                                            Background="#CC10B981"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_QuickSwitcher_ActiveBadge}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}"
                                           Foreground="#A8FFFFFF"
                                           FontSize="11.5"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Monitor Badge + Quick Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Border CornerRadius="5"
                                        Padding="6,2"
                                        Margin="0,0,6,0"
                                        Background="#22FFFFFF"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MonitorBadge}"
                                               Foreground="#DDFFFFFF"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <Button Content="⇄"
                                        ToolTip="{DynamicResource Str_Switcher_MoveNextMonitorTip}"
                                        Visibility="{Binding MoveMonitorVisibility}"
                                        Tag="{Binding ProcessId}"
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Foreground="White"
                                        Background="#20FFFFFF"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="MoveMonitor_Click"/>
                                <Button Content="—"
                                        ToolTip="{DynamicResource Str_Switcher_MinimizeRestoreTip}"
                                        Tag="{Binding ProcessId}"
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Foreground="White"
                                        Background="#20FFFFFF"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="MinimizeItem_Click"/>
                                <Button Content="✕"
                                        ToolTip="{DynamicResource Str_Switcher_CloseWindowTip}"
                                        Tag="{Binding ProcessId}"
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        Foreground="#FFFCA5A5"
                                        Background="#28EF4444"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="CloseItem_Click"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty State -->
            <TextBlock x:Name="EmptyStateText"
                       Grid.Row="2"
                       Text="{DynamicResource Str_QuickSwitcher_Empty}"
                       Foreground="#99FFFFFF"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,24"
                       Visibility="Collapsed"/>

            <!-- Footer hint -->
            <TextBlock Grid.Row="3"
                       Text="{DynamicResource Str_QuickSwitcher_FooterHint}"
                       Foreground="#88FFFFFF"
                       FontSize="11"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
