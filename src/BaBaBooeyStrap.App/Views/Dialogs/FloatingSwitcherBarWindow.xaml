<Window x:Class="BaBaBooeyStrap.App.Views.Dialogs.FloatingSwitcherBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border Margin="8"
            CornerRadius="12"
            Padding="6,5"
            Background="#EB181C24"
            BorderBrush="#3DFFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Drag Handle -->
            <Border x:Name="DragHandle"
                    Padding="5,4"
                    Margin="0,0,4,0"
                    CornerRadius="6"
                    Background="#18FFFFFF"
                    Cursor="SizeAll"
                    ToolTip="{DynamicResource Str_FloatingBar_DragTip}"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                    MouseMove="DragHandle_MouseMove"
                    MouseLeftButtonUp="DragHandle_MouseLeftButtonUp"
                    LostMouseCapture="DragHandle_LostMouseCapture">
                <TextBlock Text="⋮⋮"
                           Foreground="#CCFFFFFF"
                           FontSize="12"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Collapse/Expand Button -->
            <Button x:Name="CollapseButton"
                    Padding="7,4"
                    Margin="0,0,4,0"
                    Foreground="White"
                    Background="#20FFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    ToolTip="{DynamicResource Str_FloatingBar_CollapseTip}"
                    Click="CollapseButton_Click">
                <TextBlock x:Name="CollapseButtonLabel" Text="◀"/>
            </Button>

            <!-- Expanded Content -->
            <StackPanel x:Name="ExpandedPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <ItemsControl x:Name="AccountsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding ProcessId}"
                                    Margin="0,0,4,0"
                                    Padding="9,4"
                                    MinWidth="54"
                                    MaxWidth="150"
                                    Foreground="{Binding ForegroundBrush}"
                                    Background="{Binding BackgroundBrush}"
                                    BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="{Binding ToolTipText}"
                                    Click="AccountPill_Click"
                                    MouseRightButtonUp="AccountPill_MouseRightButtonUp">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IndexPrefix}"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Opacity="0.85"
                                               Margin="0,0,4,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="105"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="NoInstancesLabel"
                           Text="{DynamicResource Str_FloatingBar_NoWindows}"
                           Foreground="#99FFFFFF"
                           FontSize="11.5"
                           Margin="4,0,6,0"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <Border Width="1" Height="18" Background="#2FFFFFFF" Margin="2,0,6,0" VerticalAlignment="Center"/>

                <!-- Quick Tools -->
                <Button x:Name="QuickSwitcherBtn"
                        Content="⊞"
                        ToolTip="{DynamicResource Str_FloatingBar_QuickSwitcherTip}"
                        AutomationProperties.Name="{DynamicResource Str_FloatingBar_QuickSwitcherTip}"
                        Width="26"
                        Height="26"
                        Margin="0,0,4,0"
                        Padding="0"
                        Foreground="White"
                        Background="#22FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="QuickSwitcherBtn_Click"/>
                <Button x:Name="TileMenuBtn"
                        Content="◫"
                        ToolTip="{DynamicResource Str_FloatingBar_TileTip}"
                        AutomationProperties.Name="{DynamicResource Str_FloatingBar_TileTip}"
                        Width="26"
                        Height="26"
                        Margin="0,0,4,0"
                        Padding="0"
                        Foreground="White"
                        Background="#22FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="TileMenuBtn_Click"/>
                <Button x:Name="MinimizeAllBtn"
                        Content="—"
                        ToolTip="{DynamicResource Str_FloatingBar_MinimizeAllTip}"
                        AutomationProperties.Name="{DynamicResource Str_FloatingBar_MinimizeAllTip}"
                        Width="26"
                        Height="26"
                        Margin="0,0,4,0"
                        Padding="0"
                        Foreground="White"
                        Background="#22FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="MinimizeAllBtn_Click"/>
                <Button x:Name="HideBarBtn"
                        Content="✕"
                        ToolTip="{DynamicResource Str_FloatingBar_HideTip}"
                        AutomationProperties.Name="{DynamicResource Str_FloatingBar_HideTip}"
                        Width="26"
                        Height="26"
                        Padding="0"
                        Foreground="#DDFFFFFF"
                        Background="#22FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="HideBarBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
