<ui:FluentWindow x:Class="BaBaBooeyStrap.App.Views.Dialogs.FirstRunDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Str_FirstRun_Title}"
                 Width="560"
                 SizeToContent="Height"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     Title="{DynamicResource Str_FirstRun_Title}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,10,24,18">
            <TextBlock Text="{DynamicResource Str_FirstRun_WelcomeHeader}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,6" />
            <TextBlock Text="{DynamicResource Str_FirstRun_WelcomeDesc}"
                       Opacity="0.78"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- Language & Theme -->
            <Border CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_Language}" VerticalAlignment="Center" />
                        <ComboBox x:Name="LanguageCombo"
                                  Grid.Column="1"
                                  ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"
                                  SelectionChanged="LanguageCombo_SelectionChanged" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str_Appearance_AppTheme}" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeCombo"
                                  Grid.Column="1"
                                  ItemTemplate="{DynamicResource LocalizedEnumItemTemplate}"
                                  SelectionChanged="ThemeCombo_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Daily Setup Options -->
            <Border CornerRadius="8"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_FirstRun_SetupHeader}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <CheckBox x:Name="DesktopShortcutCheck"
                              Content="{DynamicResource Str_FirstRun_DesktopShortcut}"
                              IsChecked="True"
                              Margin="0,0,0,8" />
                    <CheckBox x:Name="MultiInstanceTrayCheck"
                              Content="{DynamicResource Str_FirstRun_MultiInstanceTray}"
                              IsChecked="True"
                              Margin="0,0,0,8" />
                    <CheckBox x:Name="RegisterProtocolsCheck"
                              Content="{DynamicResource Str_FirstRun_RegisterProtocols}"
                              IsChecked="True"
                              Margin="0,0,0,8" />
                    <CheckBox x:Name="RunOnStartupCheck"
                              Content="{DynamicResource Str_FirstRun_RunOnStartup}"
                              IsChecked="False" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="24,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource Str_FirstRun_GetStarted}"
                           Appearance="Primary"
                           IsDefault="True"
                           MinWidth="140"
                           Click="GetStarted_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
