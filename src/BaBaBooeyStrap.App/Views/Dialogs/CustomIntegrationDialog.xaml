<ui:FluentWindow x:Class="BaBaBooeyStrap.App.Views.Dialogs.CustomIntegrationDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Str_IntegrationDialog_Title}"
                 Width="500"
                 SizeToContent="Height"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     Title="{DynamicResource Str_IntegrationDialog_Title}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,10,20,14">
            <TextBlock Text="{DynamicResource Str_IntegrationDialog_NameLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ui:TextBox x:Name="NameBox"
                        PlaceholderText="{DynamicResource Str_IntegrationDialog_NamePlaceholder}"
                        Margin="0,0,0,10" />

            <TextBlock Text="{DynamicResource Str_IntegrationDialog_LocationLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="LocationBox"
                            Grid.Column="0"
                            PlaceholderText="C:\Tools\MyTool.exe"
                            Margin="0,0,8,0" />
                <ui:Button Grid.Column="1"
                           Content="{DynamicResource Str_Common_Browse}"
                           Click="Browse_Click" />
            </Grid>

            <TextBlock Text="{DynamicResource Str_IntegrationDialog_ArgsLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ui:TextBox x:Name="ArgsBox"
                        PlaceholderText="--flag"
                        Margin="0,0,0,10" />

            <TextBlock Text="{DynamicResource Str_IntegrationDialog_DelayLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ui:NumberBox x:Name="DelayBox"
                          Minimum="0"
                          Maximum="60000"
                          Value="0"
                          SpinButtonPlacementMode="Inline"
                          Margin="0,0,0,10" />

            <CheckBox x:Name="PreLaunchCheck"
                      Content="{DynamicResource Str_IntegrationDialog_PreLaunch}"
                      Margin="0,0,0,6" />
            <CheckBox x:Name="AutoCloseCheck"
                      Content="{DynamicResource Str_IntegrationDialog_AutoClose}"
                      IsChecked="True" />

            <TextBlock x:Name="ErrorText"
                       Foreground="#FFEF4444"
                       FontSize="12"
                       Visibility="Collapsed"
                       Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="20,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource Str_Common_Cancel}"
                           IsCancel="True"
                           Click="Cancel_Click"
                           MinWidth="88"
                           Margin="0,0,8,0" />
                <ui:Button Content="{DynamicResource Str_Common_Save}"
                           Appearance="Primary"
                           IsDefault="True"
                           MinWidth="96"
                           Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
