<ui:FluentWindow x:Class="BaBaBooeyStrap.App.Views.Dialogs.AddAccountDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Str_AddAccount_Title}"
                 Width="500"
                 Height="320"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource Str_AddAccount_Title}"/>

        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <TextBlock Text="{DynamicResource Str_AddAccount_CookieLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ui:PasswordBox x:Name="CookieBox" Margin="0,0,0,10"/>

            <TextBlock Text="{DynamicResource Str_AddAccount_NotesLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="NotesBox" PlaceholderText="{DynamicResource Str_AddAccount_NotesPlaceholder}" Margin="0,0,0,10"/>

            <TextBlock x:Name="StatusText" Text="{DynamicResource Str_AddAccount_InitialStatus}" Opacity="0.75" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="{DynamicResource Str_Common_Cancel}" Click="Cancel_Click" Margin="0,0,8,0"/>
            <ui:Button x:Name="VerifyAddButton" Content="{DynamicResource Str_AddAccount_VerifyAndSave}" Appearance="Primary" Click="VerifyAdd_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
