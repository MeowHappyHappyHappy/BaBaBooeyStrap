<ui:FluentWindow x:Class="BaBaBooeyStrap.App.Views.Dialogs.AddAccountDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Title="{DynamicResource Str_AddAccount_Title}"
                 Width="600"
                 Height="640"
                 MinWidth="520"
                 MinHeight="460"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     Title="{DynamicResource Str_AddAccount_Title}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <TabControl x:Name="LoginTabControl"
                    Grid.Row="1"
                    Margin="16,8,16,8"
                    SelectionChanged="LoginTabControl_SelectionChanged">
            <!-- Tab 1: Embedded WebView2 Login -->
            <TabItem x:Name="WebLoginTab" Header="{DynamicResource Str_AddAccount_TabWebLogin}">
                <Grid Margin="0,8,0,0">
                    <Border CornerRadius="6"
                            ClipToBounds="True"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <wv2:WebView2 x:Name="LoginWebView" />

                            <StackPanel x:Name="WebLoginLoadingOverlay"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ui:ProgressRing Width="32" Height="32" IsIndeterminate="True" Margin="0,0,0,10" />
                                <TextBlock Text="{DynamicResource Str_AddAccount_WebLoading}"
                                           Opacity="0.8"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <Border x:Name="WebViewFallbackPanel"
                                    Visibility="Collapsed"
                                    Padding="24"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                    <TextBlock Text="{DynamicResource Str_AddAccount_WebViewMissingTitle}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="WebViewFallbackDetailText"
                                               Text="{DynamicResource Str_AddAccount_WebViewMissingDesc}"
                                               Opacity="0.8"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,0,0,14" />
                                    <WrapPanel HorizontalAlignment="Center">
                                        <ui:Button Content="{DynamicResource Str_AddAccount_DownloadWebView2}"
                                                   Click="DownloadWebView2_Click"
                                                   Margin="0,0,8,8" />
                                        <ui:Button Content="{DynamicResource Str_AddAccount_SwitchToManual}"
                                                   Appearance="Primary"
                                                   Click="SwitchToManualTab_Click"
                                                   Margin="0,0,0,8" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Manual Cookie Input -->
            <TabItem x:Name="ManualCookieTab" Header="{DynamicResource Str_AddAccount_TabManualCookie}">
                <StackPanel Margin="6,12,6,0">
                    <TextBlock Text="{DynamicResource Str_AddAccount_CookieLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:PasswordBox x:Name="CookieBox" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource Str_AddAccount_CookieHint}"
                               FontSize="12"
                               Opacity="0.72"
                               TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Shared Notes & Verification Status -->
        <StackPanel Grid.Row="2" Margin="20,4,20,12">
            <TextBlock Text="{DynamicResource Str_AddAccount_NotesLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ui:TextBox x:Name="NotesBox"
                        PlaceholderText="{DynamicResource Str_AddAccount_NotesPlaceholder}"
                        Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ProgressRing x:Name="VerifyProgressRing"
                                 Width="18"
                                 Height="18"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Text="{DynamicResource Str_AddAccount_WebInitialStatus}"
                           Opacity="0.82"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="3"
                Padding="20,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource Str_Common_Cancel}"
                           IsCancel="True"
                           Click="Cancel_Click"
                           MinWidth="88"
                           Margin="0,0,8,0" />
                <ui:Button x:Name="VerifyAddButton"
                           Content="{DynamicResource Str_AddAccount_VerifyAndSave}"
                           Appearance="Primary"
                           IsDefault="True"
                           MinWidth="110"
                           Visibility="Collapsed"
                           Click="VerifyAdd_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
