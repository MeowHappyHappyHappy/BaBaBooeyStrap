<ui:FluentWindow x:Class="BaBaBooeyStrap.App.Views.Dialogs.FastFlagEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:conv="clr-namespace:BaBaBooeyStrap.App.Converters"
                 xmlns:services="clr-namespace:BaBaBooeyStrap.App.Services"
                 Title="{DynamicResource Str_FastFlagEditor_Title}"
                 Width="860"
                 Height="600"
                 MinWidth="680"
                 MinHeight="460"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource Str_FastFlagEditor_Title}"/>

        <!-- Search & Action Toolbar -->
        <StackPanel Grid.Row="1" Margin="0,8,0,10">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="SearchBox"
                            Grid.Column="0"
                            AutomationProperties.Name="{DynamicResource Str_FastFlagEditor_SearchPlaceholder}"
                            PlaceholderText="{DynamicResource Str_FastFlagEditor_SearchPlaceholder}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,8,0"/>

                <ComboBox x:Name="TypeFilterBox"
                          Grid.Column="1"
                          AutomationProperties.Name="{DynamicResource Str_FastFlagEditor_ColType}"
                          Width="140"
                          SelectionChanged="TypeFilterBox_SelectionChanged">
                    <ComboBoxItem Tag="All" Content="{DynamicResource Str_FastFlagEditor_TypeAll}" IsSelected="True"/>
                    <ComboBoxItem Tag="Boolean" Content="{DynamicResource Str_FastFlagEditor_TypeBoolean}"/>
                    <ComboBoxItem Tag="Integer" Content="{DynamicResource Str_FastFlagEditor_TypeInteger}"/>
                    <ComboBoxItem Tag="String" Content="{DynamicResource Str_FastFlagEditor_TypeString}"/>
                    <ComboBoxItem Tag="Log" Content="{DynamicResource Str_FastFlagEditor_TypeLog}"/>
                    <ComboBoxItem Tag="Unknown" Content="{DynamicResource Str_FastFlagEditor_TypeUnknown}"/>
                </ComboBox>
            </Grid>

            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource Str_FastFlagEditor_ImportJson}" Click="ImportJson_Click" Margin="0,0,6,0"/>
                <ui:Button Content="{DynamicResource Str_FastFlagEditor_ExportJson}" Click="ExportJson_Click" Margin="0,0,6,0"/>
                <ui:Button Content="{DynamicResource Str_FastFlagEditor_DeleteSelected}" Click="DeleteSelected_Click" Margin="0,0,6,0"/>
                <ui:Button Content="{DynamicResource Str_FastFlagEditor_Clear}" Click="ClearAll_Click"/>
            </WrapPanel>
        </StackPanel>

        <!-- Inline Add/Edit Row -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="FlagNameBox"
                        Grid.Column="0"
                        PlaceholderText="{DynamicResource Str_FastFlagEditor_FlagNamePlaceholder}"
                        Margin="0,0,8,0"/>
            <ui:TextBox x:Name="FlagValueBox"
                        Grid.Column="1"
                        PlaceholderText="{DynamicResource Str_FastFlagEditor_FlagValuePlaceholder}"
                        Margin="0,0,8,0"/>
            <ui:Button Grid.Column="2"
                       Content="{DynamicResource Str_FastFlagEditor_AddOrUpdate}"
                       Appearance="Primary"
                       Click="AddOrUpdateFlag_Click"
                       Margin="0,0,6,0"/>
            <ui:Button Grid.Column="3"
                       Content="{DynamicResource Str_FastFlagEditor_ResetDefaults}"
                       Click="ResetDefaults_Click"/>
        </Grid>

        <!-- DataGrid -->
        <ui:DataGrid x:Name="FlagsDataGrid"
                     Grid.Row="3"
                     ItemsSource="{Binding FlagsView}"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     SelectionMode="Extended"
                     VirtualizingPanel.IsVirtualizing="True"
                     EnableRowVirtualization="True"
                     GridLinesVisibility="Horizontal"
                     HeadersVisibility="Column"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                     Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Name}" Width="2*" IsReadOnly="True">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{DynamicResource Str_FastFlagEditor_ColFlagName}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="*">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{DynamicResource Str_FastFlagEditor_ColValue}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="110" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{DynamicResource Str_FastFlagEditor_ColType}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Margin="6,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static conv:LocalizedEnumMultiConverter.Instance}">
                                        <Binding Path="Type"/>
                                        <Binding Source="{x:Static services:LocalizationService.Instance}" Path="CurrentLanguageTag"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!-- Status / Error InfoBar -->
        <ui:InfoBar x:Name="StatusBanner"
                    Grid.Row="4"
                    IsOpen="False"
                    IsClosable="True"
                    Margin="0,0,0,8"/>

        <!-- Footer -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,12,0" TextTrimming="CharacterEllipsis">
                <TextBlock.Text>
                    <MultiBinding Converter="{x:Static conv:LocalizedFormatMultiConverter.Instance}" ConverterParameter="Str_FastFlagEditor_FooterCountFormat">
                        <Binding Source="{x:Static services:LocalizationService.Instance}" Path="CurrentLanguageTag"/>
                        <Binding Path="FilteredFlagCount" Mode="OneWay"/>
                        <Binding Path="TotalFlagCount" Mode="OneWay"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource Str_Common_Cancel}" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="90"/>
                <ui:Button Content="{DynamicResource Str_FastFlagEditor_SaveAndClose}" Appearance="Primary" Click="SaveAndClose_Click" MinWidth="120"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
