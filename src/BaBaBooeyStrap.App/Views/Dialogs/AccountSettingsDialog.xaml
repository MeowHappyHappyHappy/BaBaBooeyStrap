<ui:FluentWindow x:Class="BaBaBooeyStrap.App.Views.Dialogs.AccountSettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Str_AccountSettings_Title}"
                 Width="580"
                 Height="660"
                 MinWidth="520"
                 MinHeight="560"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResizeWithGrip"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource Str_AccountSettings_Title}"/>

        <!-- Header Card -->
        <Border Grid.Row="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,8,0,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="AccountTitleText" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Str_AccountSettings_HeaderDesc}"
                           FontSize="12"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Quick Presets -->
                <Border CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Str_AccountSettings_QuickPresets}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <ui:Button Grid.Column="1"
                                   Content="{DynamicResource Str_AccountSettings_ApplyAfkPreset}"
                                   Appearance="Primary"
                                   Margin="0,0,8,0"
                                   Click="ApplyAfkPresetButton_Click"/>
                        <ui:Button Grid.Column="2"
                                   Content="{DynamicResource Str_AccountSettings_ResetAll}"
                                   Click="ResetAllButton_Click"/>
                    </Grid>
                </Border>

                <!-- Core Settings -->
                <Border CornerRadius="8"
                        Padding="14,12"
                        Margin="0,0,0,12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_AccountSettings_BasicHeader}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <!-- Volume -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="VolumeOverrideCheck"
                                      Grid.Column="0"
                                      Content="{DynamicResource Str_AccountSettings_OverrideVolume}"
                                      VerticalAlignment="Center"
                                      Checked="OverrideCheck_Changed"
                                      Unchecked="OverrideCheck_Changed"/>
                            <Slider x:Name="VolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="VolumeValueText"
                                       Grid.Column="2"
                                       Text="50%"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Opacity="0.8"/>
                        </Grid>

                        <!-- Quality Level -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="QualityOverrideCheck"
                                      Grid.Column="0"
                                      Content="{DynamicResource Str_AccountSettings_OverrideQuality}"
                                      VerticalAlignment="Center"
                                      Checked="OverrideCheck_Changed"
                                      Unchecked="OverrideCheck_Changed"/>
                            <ComboBox x:Name="QualityComboBox" Grid.Column="1"/>
                        </Grid>

                        <!-- FPS Cap -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="FpsOverrideCheck"
                                      Grid.Column="0"
                                      Content="{DynamicResource Str_AccountSettings_OverrideFps}"
                                      VerticalAlignment="Center"
                                      Checked="OverrideCheck_Changed"
                                      Unchecked="OverrideCheck_Changed"/>
                            <ComboBox x:Name="FpsComboBox"
                                      Grid.Column="1"
                                      IsEditable="True"/>
                        </Grid>

                        <!-- Display Mode -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="FullscreenOverrideCheck"
                                      Grid.Column="0"
                                      Content="{DynamicResource Str_AccountSettings_OverrideFullscreen}"
                                      VerticalAlignment="Center"
                                      Checked="OverrideCheck_Changed"
                                      Unchecked="OverrideCheck_Changed"/>
                            <ComboBox x:Name="FullscreenComboBox" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Custom XML Property Overrides -->
                <Border CornerRadius="8"
                        Padding="14,12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="170"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{DynamicResource Str_AccountSettings_CustomHeader}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <ui:Button Grid.Column="1"
                                       Content="{DynamicResource Str_AccountSettings_AddRow}"
                                       Margin="0,0,6,0"
                                       Click="AddCustomRowButton_Click"/>
                            <ui:Button Grid.Column="2"
                                       Content="{DynamicResource Str_AccountSettings_RemoveRow}"
                                       Appearance="Danger"
                                       Click="RemoveCustomRowButton_Click"/>
                        </Grid>

                        <ui:DataGrid x:Name="CustomOverridesGrid"
                                     Grid.Row="1"
                                     AutoGenerateColumns="False"
                                     CanUserAddRows="False"
                                     CanUserDeleteRows="False"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{DynamicResource Str_AccountSettings_ColKey}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="160">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{DynamicResource Str_AccountSettings_ColValue}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </ui:DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="{DynamicResource Str_Common_Cancel}" Click="CancelButton_Click" Margin="0,0,8,0" MinWidth="90"/>
            <ui:Button Content="{DynamicResource Str_AccountSettings_SaveSettings}" Appearance="Primary" Click="SaveButton_Click" MinWidth="110"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
