<Window x:Class="BaBaBooeyStrap.App.Views.Dialogs.ServerJoinToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseEnter="Toast_MouseEnter"
        MouseLeave="Toast_MouseLeave"
        MouseLeftButtonUp="Toast_MouseLeftButtonUp">
    <Border x:Name="CardBorder"
            MaxWidth="360"
            MinWidth="270"
            Margin="12"
            Padding="14,12"
            CornerRadius="10"
            Cursor="Hand"
            Background="#F2202020"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Flag Container -->
            <Border Grid.Column="0"
                    Width="40"
                    Height="28"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Background="#2D4A7C"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <TextBlock x:Name="FallbackIsoText"
                               Text="??"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Image x:Name="FlagImage"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="LocationText"
                           Foreground="#E6FFFFFF"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="EndpointText"
                           Foreground="#A6FFFFFF"
                           FontSize="11"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <Border x:Name="CopiedBadge"
                        Visibility="Collapsed"
                        Background="#CC10B981"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Left">
                    <TextBlock x:Name="CopiedBadgeText"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
