<Window x:Class="BaBaBooeyStrap.App.Views.Dialogs.Bootstrapper.ByfronDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="440"
        Height="250"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="#FF121318" CornerRadius="12" BorderBrush="#FF2A2D38" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,16">
                <Image Source="{Binding IconSource}" Width="48" Height="48" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Str_Bootstrapper_ByfronSubtitle}" FontSize="11" Foreground="#FF7A869A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Message}" FontSize="13" Foreground="#FFE1E6EF" HorizontalAlignment="Center" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Value="{Binding ProgressValue}"
                             Maximum="{Binding ProgressMaximum}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Height="6"
                             Foreground="#FF3B82F6"
                             Background="#FF232632"/>
                <TextBlock Text="{Binding PackageProgressText}" FontSize="11" Foreground="#FF8B95A5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <Button Grid.Row="2"
                    Content="{DynamicResource Str_Bootstrapper_Cancel}"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding CancelEnabled}"
                    HorizontalAlignment="Center"
                    Width="100"
                    Height="30"
                    Margin="0,12,0,0"
                    Background="#FF1F232E"
                    Foreground="#FFE1E6EF"
                    BorderBrush="#FF363C4D"/>
        </Grid>
    </Border>
</Window>
