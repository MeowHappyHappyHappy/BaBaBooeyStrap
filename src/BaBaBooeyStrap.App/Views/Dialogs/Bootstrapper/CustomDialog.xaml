<Window x:Class="BaBaBooeyStrap.App.Views.Dialogs.Bootstrapper.CustomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BaBaBooeyStrap.App.Converters"
        xmlns:services="clr-namespace:BaBaBooeyStrap.App.Services"
        Title="{Binding Title}"
        Width="{Binding ThemeColors.Width, FallbackValue=500}"
        Height="{Binding ThemeColors.Height, FallbackValue=320}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <conv:HexStringToBrushConverter x:Key="HexToBrush"/>
        <conv:LocalizedFormatMultiConverter x:Key="LocalizedFormatMultiConverter"/>
    </Window.Resources>

    <Grid Background="{Binding ThemeColors.Background, Converter={StaticResource HexToBrush}}"
          TextElement.Foreground="{Binding ThemeColors.Foreground, Converter={StaticResource HexToBrush}}">
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="{Binding IconSource}" Width="40" Height="40" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock FontSize="11" Opacity="0.7">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocalizedFormatMultiConverter}" ConverterParameter="Str_Bootstrapper_CustomThemeFormat">
                            <Binding Source="{x:Static services:LocalizationService.Instance}" Path="CurrentLanguageTag"/>
                            <Binding Path="ThemeColors.Name"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Message}" FontSize="13.5" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
            <ProgressBar Value="{Binding ProgressValue}"
                         Maximum="{Binding ProgressMaximum}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Height="10"
                         Foreground="{Binding ThemeColors.Accent, Converter={StaticResource HexToBrush}}"/>
            <TextBlock Text="{Binding PackageProgressText}" FontSize="11.5" Opacity="0.75" Margin="0,6,0,0"/>
        </StackPanel>

        <Button Grid.Row="2"
                Content="{DynamicResource Str_Bootstrapper_Cancel}"
                Command="{Binding CancelCommand}"
                IsEnabled="{Binding CancelEnabled}"
                HorizontalAlignment="Right"
                Width="96"
                Height="30"/>
        </Grid>
    </Grid>
</Window>
