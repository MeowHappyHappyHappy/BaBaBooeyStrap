<Window x:Class="BaBaBooeyStrap.App.Views.Dialogs.Bootstrapper.LegacyProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="410"
        Height="170"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF0F0F0"
        Foreground="#FF000000">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="{Binding IconSource}" Width="32" Height="32" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding Message}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <ProgressBar Value="{Binding ProgressValue}"
                         Maximum="{Binding ProgressMaximum}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Height="16"/>
            <TextBlock Text="{Binding PackageProgressText}" FontSize="11" Foreground="#FF555555" Margin="0,4,0,0"/>
        </StackPanel>

        <Button Grid.Row="2"
                Content="{DynamicResource Str_Bootstrapper_Cancel}"
                Command="{Binding CancelCommand}"
                IsEnabled="{Binding CancelEnabled}"
                HorizontalAlignment="Right"
                Width="80"
                Height="24"/>
    </Grid>
</Window>
