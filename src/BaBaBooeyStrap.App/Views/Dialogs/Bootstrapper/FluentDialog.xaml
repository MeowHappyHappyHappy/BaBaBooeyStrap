<ui:FluentWindow x:Class="BaBaBooeyStrap.App.Views.Dialogs.Bootstrapper.FluentDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding Title}"
                 Width="480"
                 Height="210"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,16">
            <Image Source="{Binding IconSource}" Width="36" Height="36" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Message}" FontSize="13" Opacity="0.82" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <ProgressBar Value="{Binding ProgressValue}"
                         Maximum="{Binding ProgressMaximum}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Height="8"
                         Margin="0,0,0,8"/>
            <TextBlock Text="{Binding PackageProgressText}" FontSize="12" Opacity="0.7"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="{DynamicResource Str_Bootstrapper_Cancel}"
                       Command="{Binding CancelCommand}"
                       IsEnabled="{Binding CancelEnabled}"
                       Appearance="Secondary"
                       MinWidth="90"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
