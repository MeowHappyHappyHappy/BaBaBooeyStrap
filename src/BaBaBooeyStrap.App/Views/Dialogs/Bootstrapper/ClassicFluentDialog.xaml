<Window x:Class="BaBaBooeyStrap.App.Views.Dialogs.Bootstrapper.ClassicFluentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="460"
        Height="195"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF1E1E1E"
        Foreground="#FFFFFFFF">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="{Binding IconSource}" Width="32" Height="32" Margin="0,0,12,0"/>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="#FFCCCCCC"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <ProgressBar Value="{Binding ProgressValue}"
                         Maximum="{Binding ProgressMaximum}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Height="10"
                         Foreground="#FF0078D4"
                         Background="#FF333333"/>
            <TextBlock Text="{Binding PackageProgressText}" FontSize="11.5" Foreground="#FFAAAAAA" Margin="0,6,0,0"/>
        </StackPanel>

        <Button Grid.Row="2"
                Content="{DynamicResource Str_Bootstrapper_Cancel}"
                Command="{Binding CancelCommand}"
                IsEnabled="{Binding CancelEnabled}"
                HorizontalAlignment="Right"
                Width="86"
                Height="28"
                Background="#FF2D2D30"
                Foreground="#FFFFFFFF"
                BorderBrush="#FF555555"/>
    </Grid>
</Window>
