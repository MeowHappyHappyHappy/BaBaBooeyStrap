<Window x:Class="BaBaBooeyStrap.App.Views.Dialogs.Bootstrapper.TerminalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="580"
        Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FF0C0C0C"
        Foreground="#FFCCCCCC">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title, StringFormat='C:\\BaBaBooeyStrap&gt; bootstrap --target={0}'}"
                   FontFamily="Consolas"
                   FontSize="12.5"
                   Foreground="#FF4EC9B0"
                   Margin="0,0,0,8"/>

        <ListBox x:Name="LogListBox"
                 Grid.Row="1"
                 SelectionMode="Extended"
                 ItemsSource="{Binding LogLines}"
                 Background="#FF0A0A0A"
                 Foreground="#FFD4D4D4"
                 BorderBrush="#FF333333"
                 FontFamily="Consolas"
                 FontSize="11.5"
                 PreviewKeyDown="LogListBox_PreviewKeyDown"
                 Margin="0,0,0,10"/>

        <ProgressBar Grid.Row="2"
                     Value="{Binding ProgressValue}"
                     Maximum="{Binding ProgressMaximum}"
                     IsIndeterminate="{Binding IsIndeterminate}"
                     Height="8"
                     Foreground="#FF16C60C"
                     Background="#FF1F1F1F"
                     Margin="0,0,0,10"/>

        <DockPanel Grid.Row="3">
            <TextBlock Text="{Binding PackageProgressText}" FontFamily="Consolas" FontSize="11" Foreground="#FF888888" VerticalAlignment="Center"/>
            <Button Content="{DynamicResource Str_Bootstrapper_CancelCtrlC}"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding CancelEnabled}"
                    HorizontalAlignment="Right"
                    Padding="12,4"
                    FontFamily="Consolas"
                    Background="#FF1E1E1E"
                    Foreground="#FFFFFFFF"
                    BorderBrush="#FF444444"/>
        </DockPanel>
    </Grid>
</Window>
